# Shell scripts are executed inside Linux containers, so they must keep LF
# endings regardless of the platform they are checked out on. Without this a
# Windows clone gives compose/init-floci.sh CRLF endings and `set -eu` fails
# with "invalid option", leaving the AWS resources unprovisioned.
*.sh text eol=lf

# Verify snapshot files. VerifyChecks.Run skips this check when no .gitattributes
# exists, so adding the file above makes these entries required.
*.verified.txt text eol=lf working-tree-encoding=UTF-8
*.verified.xml text eol=lf working-tree-encoding=UTF-8
*.verified.json text eol=lf working-tree-encoding=UTF-8
